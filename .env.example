# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/borrowbook

# JWT
SECRET_KEY=change-me-in-production

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# S3 / Cloudflare R2
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=borrowbook
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxxx.r2.dev

# OCR.Space API key (optional — free tier key "helloworld" used if empty)
OCR_SPACE_API_KEY=

# App
DEBUG=false
